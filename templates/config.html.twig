{#
 # -------------------------------------------------------------------------
 # Grafana plugin for GLPI
 # -------------------------------------------------------------------------
 # Plugin configuration form (shown in Setup → General → Grafana tab).
 #
 # Variables:
 #   form_url        string       POST target for the config form
 #   current_config  array        Saved values: url, username, lightmode
 #   jwks_url        string       Absolute URL of front/jwks.php
 #   is_valid        bool         Whether the current config can reach Grafana
 #   api_status      array|null   label => bool map of API health checks
 #   last_error      array|null   Last API error (keys: exception, …)
 #   dashboards_url  string       URL of front/dashboards.php
 # -------------------------------------------------------------------------
 #}

<div class="grafana_config">
    <div class="d-flex align-items-center mb-3 gap-3">
        <h1 class="mb-0 flex-grow-1">{{ __('Grafana plugin configuration', 'grafana') }}</h1>
        <a href="{{ rights_url }}" class="btn btn-outline-secondary btn-md flex-shrink-0">
            <i class="ti ti-shield-lock"></i>
            {{ __('Manage dashboard permissions', 'grafana') }}
        </a>
    </div>

    {# ── Security model note ──────────────────────────────────────────── #}
    <div class="alert alert-warning mb-4" role="alert">
        <div class="d-flex align-items-center" id="grafana-security-notice-header"
             style="cursor:pointer; user-select:none;"
             role="button" aria-expanded="true" aria-controls="grafana-security-notice-body">
            <i class="ti ti-shield-exclamation me-2"></i>
            <strong class="flex-grow-1">{{ __('Security model — important', 'grafana') }}</strong>
            <i class="ti ti-chevron-up ms-2" id="grafana-security-notice-chevron"></i>
        </div>
        <div id="grafana-security-notice-body" class="mt-1">
            <p class="mb-0">
                {{ __('The per-dashboard permission grants configured in this plugin control which dashboards are displayed inside GLPI. They are a display filter only: the actual security boundary in Grafana is the permission set of the dedicated Grafana user configured below. Any GLPI user who can view at least one dashboard will authenticate to Grafana as that shared user and could reach any dashboard, folder, or data source that user has access to. Ensure the configured Grafana user has access only to the dashboards intended for GLPI users.', 'grafana') }}
            </p>
        </div>
    </div>
    <script>
    (function () {
        var header  = document.getElementById('grafana-security-notice-header');
        var body    = document.getElementById('grafana-security-notice-body');
        var chevron = document.getElementById('grafana-security-notice-chevron');
        var STORAGE_KEY = 'grafana_security_notice_collapsed';

        function applyState(collapsed, animate) {
            if (collapsed) {
                body.style.display = 'none';
                chevron.classList.replace('ti-chevron-up', 'ti-chevron-down');
                header.setAttribute('aria-expanded', 'false');
            } else {
                body.style.display = '';
                chevron.classList.replace('ti-chevron-down', 'ti-chevron-up');
                header.setAttribute('aria-expanded', 'true');
            }
        }

        var collapsed = false;
        try { collapsed = localStorage.getItem(STORAGE_KEY) === '1'; } catch (e) {}
        applyState(collapsed, false);

        header.addEventListener('click', function () {
            collapsed = !collapsed;
            applyState(collapsed, true);
            try { localStorage.setItem(STORAGE_KEY, collapsed ? '1' : '0'); } catch (e) {}
        });
    })();
    </script>

    <form name="form" action="{{ form_url }}" method="post">
        <input type="hidden" name="_glpi_csrf_token" value="{{ csrf_token() }}">

        <div id="base_config" class="grafana_config_block">

            {# --- Grafana URL --- #}
            <div class="grafana_field">
                <label class="grafana_label" for="grafanaconfig_url">
                    {{ __('Grafana URL', 'grafana') }}
                </label>
                <input type="text" name="url"
                       value="{{ current_config.url }}"
                       placeholder="https://grafana.domain"
                       required
                       class="form-control grafana_control"
                       id="grafanaconfig_url">
            </div>

            {# --- Username --- #}
            <div class="grafana_field">
                <label class="grafana_label" for="grafanaconfig_username">
                    {{ __('Dedicated Grafana user', 'grafana') }}
                </label>
                <input type="text" name="username"
                       value="{{ current_config.username }}"
                       required
                       class="form-control grafana_control"
                       id="grafanaconfig_username">
            </div>

            {# --- Password (never pre-filled) --- #}
            <div class="grafana_field">
                <label class="grafana_label" for="grafanaconfig_password">
                    {{ __('Dedicated Grafana user password', 'grafana') }}
                </label>
                <input type="password" name="fakefield" style="display:none;">
                <div class="input-group grafana_control">
                    <input type="password" name="password"
                           class="form-control"
                           id="grafanaconfig_password">
                    <button type="button" class="btn btn-outline-secondary" id="toggle_password"
                            title="{{ __('Show/hide password', 'grafana') }}">
                        <i class="ti ti-eye" id="password_eye_icon"></i>
                    </button>
                </div>
            </div>

            {# --- JWKS URL (read-only with copy button) --- #}
            <div class="grafana_field">
                <label class="grafana_label" for="grafana_jwks_url">
                    {{ __('JWKS url', 'grafana') }}
                </label>
                <div class="input-group grafana_control">
                    <input type="text" class="form-control" id="grafana_jwks_url"
                           value="{{ jwks_url }}" readonly>
                    <button id="copy_clipboard" type="button" class="btn btn-outline-secondary">
                        <i id="button_icon" class="ti ti-clipboard"></i>
                        <span id="button_text">{{ __('Copy', 'grafana') }}</span>
                    </button>
                </div>
            </div>

            {# --- Light mode checkbox --- #}
            <div class="grafana_field">
                <div class="form-check">
                    <input type="hidden" name="lightmode" value="0">
                    <input type="checkbox" class="form-check-input"
                           name="lightmode"
                           id="grafana_lightmode"
                           {{ current_config.lightmode ? 'checked' : '' }}>
                    <label class="form-check-label" for="grafana_lightmode">
                        {{ __('Grafana light mode theme', 'grafana') }}
                    </label>
                </div>
            </div>

            {# --- Token lifetime --- #}
            <div class="grafana_field">
                <label class="grafana_label" for="grafanaconfig_token_lifetime">
                    {{ __('JWT token lifetime (minutes)', 'grafana') }}
                </label>
                <input type="number" name="token_lifetime"
                       value="{{ current_config.token_lifetime ?? 10 }}"
                       min="3"
                       class="form-control grafana_control"
                       id="grafanaconfig_token_lifetime"
                       style="max-width:100px;">
                <small class="text-muted">{{ __('Minimum 3 minutes. Shorter values reduce the exposure window if a token is leaked, but increase refresh frequency.', 'grafana') }}</small>
            </div>

            {# Hidden inputs for clipboard JS translations #}
            <input type="hidden" name="copy"   id="translated_copy"   value="{{ __('Copy', 'grafana') }}">
            <input type="hidden" name="copied" id="translated_copied" value="{{ __('Copied!', 'grafana') }}">

            <input type="hidden" name="config_class"   value="GlpiPlugin\Grafana\Config">
            <input type="hidden" name="config_context" value="plugin:grafana">

            <button type="submit" name="update" value="1" class="btn btn-primary">
                <i class="ti ti-device-floppy"></i>
                <span>{{ _x('button', 'Save') }}</span>
            </button>

        </div>
    </form>

    {# ── URL params form ───────────────────────────────────────────────── #}
    <h1>{{ __('GLPI context variables for Grafana', 'grafana') }}</h1>

    <form name="form_url_params" action="{{ form_url }}" method="post">
        <input type="hidden" name="_glpi_csrf_token" value="{{ csrf_token() }}">
        <input type="hidden" name="config_class"   value="GlpiPlugin\Grafana\Config">
        <input type="hidden" name="config_context" value="plugin:grafana">

        <div class="grafana_config_block">
            <p class="text-muted mb-3" style="font-size:.9em;">
                {{ __('Selected fields are appended to the Grafana iframe URL as dashboard variables (var-&lt;key&gt;=&lt;value&gt;). Configure matching variables in each Grafana dashboard.', 'grafana') }}
            </p>

            <div class="row row-cols-1 row-cols-md-2 g-2">
                {% for key, label in url_params_pool %}
                    <div class="col">
                        <div class="form-check">
                            <input type="hidden"   name="url_param_{{ key }}" value="0">
                            <input type="checkbox" name="url_param_{{ key }}" value="1"
                                   class="form-check-input"
                                   id="url_param_{{ key }}"
                                   {{ (current_config['url_param_' ~ key] ?? '0') == '1' ? 'checked' : '' }}>
                            <label class="form-check-label" for="url_param_{{ key }}">
                                {{ label }}
                                <code class="ms-1" style="font-size:.8em;">var-{{ key }}</code>
                            </label>
                        </div>
                    </div>
                {% endfor %}
            </div>

            <button type="submit" name="update_url_params" value="1" class="btn btn-primary mt-3">
                <i class="ti ti-device-floppy"></i>
                <span>{{ _x('button', 'Save') }}</span>
            </button>
        </div>
    </form>

    {% if is_valid %}

        <h1>{{ __('API status', 'grafana') }}</h1>
        <ul>
            {% for label, ok in api_status %}
                <li>
                    <img src="{{ config('root_doc') }}/pics/{{ ok ? 'greenbutton.png' : 'redbutton.png' }}" alt="">
                    &nbsp;{{ label }}
                </li>
            {% endfor %}
        </ul>

        {% if last_error %}
            <h1>{{ __('Last Error', 'grafana') }}</h1>
            {% if last_error.exception is defined %}
                {{ last_error.exception }}
            {% else %}
                {% for key, val in last_error %}
                    {% if val is not iterable %}
                        <div><strong>{{ key }}:</strong> {{ val }}</div>
                    {% endif %}
                {% endfor %}
            {% endif %}
        {% endif %}

        <div id="actions">
            <h1>{{ __('Action(s)', 'grafana') }}</h1>
            <div class="btn-group-vertical">
                <a href="{{ dashboards_url }}" class="btn btn-outline-secondary">
                    <i class="ti ti-chart-infographic"></i>
                    <span>{{ __('Show reports and dashboards specifications', 'grafana') }}</span>
                </a>

                <form name="form_rotate_keys" action="{{ form_url }}" method="post"
                      onsubmit="return confirm('{{ __('Rotating invalidates all unused tokens immediately. Continue?', 'grafana')|e('js') }}');">
                    <input type="hidden" name="_glpi_csrf_token" value="{{ csrf_token() }}">

                    <button type="submit" name="rotate_keys" value="1" class="btn btn-outline-danger">
                        <i class="ti ti-refresh"></i>
                        <span>{{ __('Rotate signing keys now', 'grafana') }}</span>
                    </button>
                </form>
            </div>
        </div>

    {% endif %}
</div>
